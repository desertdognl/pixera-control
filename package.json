{
  "name": "pixera-control",
  "version": "0.2.5",
  "description": "Director / playback control for Pixera 25+",
  "main": "./out/main/index.js",
  "author": "Pixera Control",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "tsc -p tsconfig.test.json && node --test .tmp-test/shared/*.test.js",
    "icon:mac": "python3 scripts/overlay-play-icon.py && python3 scripts/make-mac-icon.py",
    "clean:release": "node scripts/clean-release.mjs",
    "predist": "npm run clean:release",
    "predist:mac": "npm run clean:release",
    "pack:mac": "npm run icon:mac && npm run build && node scripts/update-mac-app.mjs",
    "dist:mac": "npm run icon:mac && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^36.4.0",
    "electron-builder": "26.13.0",
    "electron-vite": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.pixeracontrol.app",
    "productName": "Pixera Control",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        {
          "target": "dir",
          "arch": ["arm64"]
        }
      ]
    }
  }
}
